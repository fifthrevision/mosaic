{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "studio/**/*.ts",
    "studio/**/*.tsx"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "noEmit": true
  }
}
